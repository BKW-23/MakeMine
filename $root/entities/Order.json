{
  "name": "Order",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "title": "T\u00ean kh\u00e1ch"
    },
    "customer_phone": {
      "type": "string",
      "title": "S\u0110T"
    },
    "customer_email": {
      "type": "string",
      "title": "Email"
    },
    "address": {
      "type": "string",
      "title": "\u0110\u1ecba ch\u1ec9"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "unit_price": {
            "type": "number"
          },
          "customization": {
            "type": "object"
          }
        }
      },
      "title": "S\u1ea3n ph\u1ea9m"
    },
    "total": {
      "type": "number",
      "title": "T\u1ed5ng ti\u1ec1n"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending",
      "title": "Tr\u1ea1ng th\u00e1i"
    },
    "preview_confirmed": {
      "type": "boolean",
      "default": false,
      "title": "\u0110\u00e3 x\u00e1c nh\u1eadn preview"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "items",
    "total"
  ]
}